# --- Backend (.NET API) ---
# Kestrel bind address
ASPNETCORE_URLS=http://localhost:5000
ASPNETCORE_ENVIRONMENT=Development

# Comma-separated origins allowed by CORS (overrides appsettings)
# Cors__AllowedOrigins__0=http://localhost:5173

# SMTP for contact-form notification emails (optional; blank = log only)
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__From=no-reply@peterogba.dev
Smtp__To=peter4tech@gmail.com
